{
  "name": "seisin",
  "version": "0.6.4",
  "description": "A permission layer for AI coding agents: role-scoped folders and keys, enforced by the OS, and when it denies something it tells you whose file it was.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "sandbox",
    "permissions",
    "multi-agent",
    "seatbelt",
    "bubblewrap",
    "codeowners",
    "rbac",
    "agent-permissions",
    "code-ownership",
    "mcp",
    "security",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Carlos Tapia",
  "homepage": "https://carlostapiacl.github.io/seisin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlostapiacl/seisin.git"
  },
  "bugs": {
    "url": "https://github.com/carlostapiacl/seisin/issues"
  },
  "type": "module",
  "bin": {
    "seisin": "./src/cli.js"
  },
  "files": [
    "src",
    "ui/index.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81"
  },
  "optionalDependencies": {
    "@carlostapiacl/tartaros": "0.1.0-alpha.18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ui": "node ui/build.js",
    "prepublishOnly": "npm test"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  }
}
