node_modules/
# Runtime state: the activity log and the request queue. Local to a checkout and
# not policy — seisin.toml is the part that belongs in the repo. Left tracked,
# the log publishes which agent touched which file and when.
.seisin/
*.log
.DS_Store
test/.sandbox-box/

# mkdtemp debris from an interrupted test run — the tests clean up, a Ctrl-C does not
test/req-*/

# npm pack output — a build artifact, not source
*.tgz

# The site reuses docs/img rather than keeping a second copy of the GIFs —
# two copies of a binary drift the moment one is regenerated. The workflow
# copies them in at build time; `site/README.md` says how to preview locally.
site/img/
